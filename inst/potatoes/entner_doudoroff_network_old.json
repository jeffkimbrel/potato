    "galactose_catabolism": {
      "name": "Galactose Catabolism (ED Entry)",
      "type": "independent",
      "kegg_module": {},
      "notes": "Galactose oxidation to galactonate, then entry into ED via bifunctional gnaD. The galactonate → KDGal conversion is catalyzed by the same gnaD enzyme that handles gluconate → KDG. KDGal is then cleaved by kdpgA (which handles both KDPG and KDGal substrates) to pyruvate + glyceraldehyde, feeding into the npED glyceraldehyde oxidation step. This pathway is characteristic of marine and soil organisms that encounter galactose from polysaccharide degradation (agar, carrageenan, pectin).",
      "nodes": {
        "gnaD": {
          "step": 1,
          "required": true,
          "marker": true
        },
